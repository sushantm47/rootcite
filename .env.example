# Copy to .env. Never commit real keys.
ROOTCITE_STAGE=local
ROOTCITE_LLM_PROVIDER=offline        # offline | anthropic | bedrock | openai
ROOTCITE_LLM_API_KEY=                # for openai: any OpenAI-compatible API (Groq by default)
ROOTCITE_LLM_BASE_URL=https://api.groq.com/openai/v1
ROOTCITE_MODEL=claude-sonnet-5       # on Bedrock, use the Bedrock model ID
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
ROOTCITE_EMBEDDER=hashing            # hashing | sentence-transformers
ROOTCITE_INDEX=memory                # memory | postgres
DATABASE_URL=
ROOTCITE_PUBLIC_DEMO=false           # true: per-visitor rate limit, ingestion disabled
